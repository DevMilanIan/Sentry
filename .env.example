# Safe defaults. LIVE cannot be enabled by this file alone.
SENTRY_CONFIG=config/app.yaml
SENTRY_EXECUTION_ENVIRONMENT=DEMO
SENTRY_DEMO_BACKEND=OFFLINE_SIM
SENTRY_TRADING_MODE=RESEARCH
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
SENTRY_DATABASE_URL=postgresql+asyncpg://sentinel:change-me@postgres:5432/sentinel
SENTRY_OLLAMA_URL=http://host.docker.internal:11434
SENTRY_OLLAMA_MODEL=qwen3.5:4b
SENTRY_DASHBOARD_TOKEN=replace-with-a-long-random-local-token
# Set only after account-backed qualification. Never commit the value.
SENTRY_LIVE_AUTHORIZATION_FILE=
