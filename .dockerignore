# Only source required for the runtime and explicit verification target enters
# the build context. Keep local credentials, virtual environments, downloaded
# installers, runtime evidence, and Git history out of the Docker daemon.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!requirements/
!requirements/container-constraints.txt
!README.md
!alembic.ini
!app/
!app/**
!config/
!config/**
!migrations/
!migrations/**
!tests/
!tests/**
!docker-compose.yml
!scripts/
!scripts/windows/
!scripts/windows/*.ps1
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
